NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000
DATABASE_URL=postgresql://borska_farmica:local_development_password@localhost:5434/borska_farmica?schema=public
SWAGGER_ENABLED=true
TRUST_PROXY=false
JSON_BODY_LIMIT=100kb
JWT_ACCESS_SECRET=development-access-secret-replace-before-production-12345
JWT_REFRESH_SECRET=development-refresh-secret-replace-before-production-67890
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800
ADMIN_REFRESH_COOKIE_NAME=bf_admin_refresh
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_FIRST_NAME=
BOOTSTRAP_ADMIN_LAST_NAME=
BOOTSTRAP_ADMIN_ROLE=
BOOTSTRAP_ADMIN_CONFIRM=

CART_COOKIE_NAME=bf_cart
CART_TTL_DAYS=30
CART_COOKIE_SECURE=false
CART_COOKIE_SAME_SITE=lax

CUSTOMER_JWT_ACCESS_SECRET=development-customer-access-secret-replace-before-production-123
CUSTOMER_JWT_REFRESH_SECRET=development-customer-refresh-secret-replace-before-production-456
CUSTOMER_JWT_ACCESS_TTL=900
CUSTOMER_JWT_REFRESH_TTL=2592000
CUSTOMER_REFRESH_COOKIE_NAME=bf_customer_refresh
CUSTOMER_COOKIE_SECURE=false
CUSTOMER_COOKIE_SAME_SITE=lax
