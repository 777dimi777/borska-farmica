generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum AvailabilityMode {
  ALWAYS
  SEASONAL
  MANUAL
}

enum MeasurementUnit {
  PIECE
  GRAM
  KILOGRAM
  MILLILITER
  LITER
  PACKAGE
  BAG
}

enum AvailabilityWindowType {
  RECURRING_ANNUAL
  FIXED_DATE_RANGE
}

enum InventoryMovementType {
  INITIAL
  RESTOCK
  SALE
  ORDER_CANCELLATION
  RETURN
  ADJUSTMENT
  DAMAGE
}

model Category {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @unique @db.VarChar(100)
  slug        String    @unique @db.VarChar(120)
  description String?   @db.Text
  imageUrl    String?   @db.VarChar(2048)
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)
  products    Product[]

  @@index([isActive, sortOrder])
}

model Product {
  id                  String               @id @default(uuid()) @db.Uuid
  categoryId          String               @db.Uuid
  name                String               @db.VarChar(160)
  slug                String               @unique @db.VarChar(180)
  shortDescription    String?              @db.VarChar(320)
  description         String?              @db.Text
  status              ProductStatus        @default(DRAFT)
  isFeatured          Boolean              @default(false)
  isMainProduct       Boolean              @default(false)
  availabilityMode    AvailabilityMode     @default(ALWAYS)
  isManuallyAvailable Boolean              @default(true)
  seoTitle            String?              @db.VarChar(70)
  seoDescription      String?              @db.VarChar(170)
  createdAt           DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime             @updatedAt @db.Timestamptz(3)
  category            Category             @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants            ProductVariant[]
  images              ProductImage[]
  availabilityWindows AvailabilityWindow[]
  orderItems          OrderItem[]

  @@index([categoryId, status])
  @@index([status])
  @@index([isFeatured, status])
  @@index([isMainProduct, status])
}

model ProductVariant {
  id                      String              @id @default(uuid()) @db.Uuid
  productId               String              @db.Uuid
  name                    String              @db.VarChar(120)
  sku                     String              @unique @db.VarChar(80)
  price                   Decimal             @db.Decimal(12, 2)
  compareAtPrice          Decimal?            @db.Decimal(12, 2)
  packageAmount           Decimal             @db.Decimal(12, 3)
  measurementUnit         MeasurementUnit
  stockQuantity           Decimal             @default(0) @db.Decimal(12, 3)
  reservedQuantity        Decimal             @default(0) @db.Decimal(12, 3)
  lowStockThreshold       Decimal             @default(0) @db.Decimal(12, 3)
  minimumPurchaseQuantity Decimal             @default(1) @db.Decimal(12, 3)
  purchaseIncrement       Decimal             @default(1) @db.Decimal(12, 3)
  allowBackorder          Boolean             @default(false)
  isDefault               Boolean             @default(false)
  isActive                Boolean             @default(true)
  sortOrder               Int                 @default(0)
  createdAt               DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime            @updatedAt @db.Timestamptz(3)
  product                 Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  inventoryMovements      InventoryMovement[]
  cartItems               CartItem[]
  orderItems              OrderItem[]
  stockReservations       StockReservation[]

  @@index([productId, isActive, sortOrder])
}

model ProductImage {
  id         String   @id @default(uuid()) @db.Uuid
  productId  String   @db.Uuid
  url        String   @db.VarChar(2048)
  storageKey String?  @db.VarChar(512)
  altText    String   @db.VarChar(240)
  isPrimary  Boolean  @default(false)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}

model AvailabilityWindow {
  id          String                 @id @default(uuid()) @db.Uuid
  productId   String                 @db.Uuid
  type        AvailabilityWindowType
  startsAt    DateTime?              @db.Date
  endsAt      DateTime?              @db.Date
  startMonth  Int?
  startDay    Int?
  endMonth    Int?
  endDay      Int?
  isActive    Boolean                @default(true)
  publicLabel String?                @db.VarChar(240)
  sortOrder   Int                    @default(0)
  createdAt   DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime               @updatedAt @db.Timestamptz(3)
  product     Product                @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, isActive])
}

model InventoryMovement {
  id             String                @id @default(uuid()) @db.Uuid
  variantId      String                @db.Uuid
  type           InventoryMovementType
  quantityDelta  Decimal               @db.Decimal(12, 3)
  resultingStock Decimal?              @db.Decimal(12, 3)
  reason         String?               @db.VarChar(500)
  reference      String?               @db.VarChar(160)
  createdAt      DateTime              @default(now()) @db.Timestamptz(3)
  variant        ProductVariant        @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([variantId, createdAt(sort: Desc)])
}

enum AdminRole {
  ADMIN
  SUPER_ADMIN
}

enum AdminStatus {
  ACTIVE
  DISABLED
}

model AdminUser {
  id           String          @id @default(uuid()) @db.Uuid
  email        String          @unique @db.VarChar(254)
  passwordHash String          @db.VarChar(255)
  firstName    String          @db.VarChar(80)
  lastName     String          @db.VarChar(80)
  role         AdminRole       @default(ADMIN)
  status       AdminStatus     @default(ACTIVE)
  lastLoginAt  DateTime?       @db.Timestamptz(3)
  createdAt    DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime        @updatedAt @db.Timestamptz(3)
  sessions     AdminSession[]
  auditLogs    AdminAuditLog[]
  orderEvents  OrderEvent[]

  @@index([status])
}

model AdminAuditLog {
  id           String    @id @default(uuid()) @db.Uuid
  adminId      String    @db.Uuid
  action       String    @db.VarChar(100)
  resourceType String    @db.VarChar(80)
  resourceId   String?   @db.Uuid
  changes      Json?
  ipAddress    String?   @db.VarChar(64)
  userAgent    String?   @db.VarChar(512)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  admin        AdminUser @relation(fields: [adminId], references: [id], onDelete: Restrict)

  @@index([adminId, createdAt(sort: Desc)])
  @@index([resourceType, resourceId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
}

model AdminSession {
  id               String    @id @default(uuid()) @db.Uuid
  adminId          String    @db.Uuid
  refreshTokenHash String    @unique @db.VarChar(64)
  expiresAt        DateTime  @db.Timestamptz(3)
  revokedAt        DateTime? @db.Timestamptz(3)
  lastUsedAt       DateTime? @db.Timestamptz(3)
  userAgent        String?   @db.VarChar(512)
  ipAddress        String?   @db.VarChar(64)
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  admin            AdminUser @relation(fields: [adminId], references: [id], onDelete: Restrict)

  @@index([adminId, revokedAt])
  @@index([expiresAt])
}

enum CartStatus {
  ACTIVE
  CONVERTED
  EXPIRED
  ABANDONED
}

model Cart {
  id          String     @id @default(uuid()) @db.Uuid
  tokenHash   String     @unique @db.VarChar(64)
  status      CartStatus @default(ACTIVE)
  currency    String     @default("RSD") @db.VarChar(3)
  expiresAt   DateTime   @db.Timestamptz(3)
  convertedAt DateTime?  @db.Timestamptz(3)
  createdAt   DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime   @updatedAt @db.Timestamptz(3)
  items       CartItem[]
  order       Order?

  @@index([status, expiresAt])
}

model CartItem {
  id                  String         @id @default(uuid()) @db.Uuid
  cartId              String         @db.Uuid
  variantId           String         @db.Uuid
  quantity            Decimal        @db.Decimal(12, 3)
  unitPriceAtAddition Decimal        @db.Decimal(12, 2)
  createdAt           DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime       @updatedAt @db.Timestamptz(3)
  cart                Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant             ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([cartId, variantId])
  @@index([cartId, createdAt])
  @@index([variantId])
}

enum CustomerStatus {
  ACTIVE
  DISABLED
}

model CustomerUser {
  id                String            @id @default(uuid()) @db.Uuid
  email             String            @unique @db.VarChar(254)
  passwordHash      String            @db.VarChar(255)
  firstName         String            @db.VarChar(80)
  lastName          String            @db.VarChar(80)
  phone             String            @db.VarChar(32)
  status            CustomerStatus    @default(ACTIVE)
  emailVerifiedAt   DateTime?         @db.Timestamptz(3)
  lastLoginAt       DateTime?         @db.Timestamptz(3)
  passwordChangedAt DateTime?         @db.Timestamptz(3)
  createdAt         DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime          @updatedAt @db.Timestamptz(3)
  sessions          CustomerSession[]
  orders            Order[]
  orderEvents       OrderEvent[]

  @@index([status])
}

model CustomerSession {
  id               String       @id @default(uuid()) @db.Uuid
  customerId       String       @db.Uuid
  refreshTokenHash String       @unique @db.VarChar(64)
  expiresAt        DateTime     @db.Timestamptz(3)
  revokedAt        DateTime?    @db.Timestamptz(3)
  lastUsedAt       DateTime?    @db.Timestamptz(3)
  userAgent        String?      @db.VarChar(512)
  ipAddress        String?      @db.VarChar(64)
  createdAt        DateTime     @default(now()) @db.Timestamptz(3)
  customer         CustomerUser @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([customerId, revokedAt])
  @@index([expiresAt])
}

enum OrderStatus {
  PENDING_CONFIRMATION
  CONFIRMED
  PREPARING
  READY_FOR_PICKUP
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH_ON_PICKUP
}

enum PaymentStatus {
  UNPAID
  PAID
}

enum StockReservationStatus {
  ACTIVE
  RELEASED
  CONSUMED
}

enum OrderActorType {
  CUSTOMER
  ADMIN
  SYSTEM
}

model PickupLocation {
  id             String   @id @default(uuid()) @db.Uuid
  code           String   @unique @db.VarChar(40)
  name           String   @db.VarChar(120)
  address        String   @db.VarChar(240)
  instructions   String?  @db.VarChar(500)
  allowedWeekday Int?
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)
  orders         Order[]

  @@index([isActive, sortOrder])
}

model Order {
  id                         String             @id @default(uuid()) @db.Uuid
  orderNumber                String             @unique @db.VarChar(32)
  customerId                 String             @db.Uuid
  cartId                     String             @unique @db.Uuid
  pickupLocationId           String             @db.Uuid
  status                     OrderStatus        @default(PENDING_CONFIRMATION)
  paymentMethod              PaymentMethod      @default(CASH_ON_PICKUP)
  paymentStatus              PaymentStatus      @default(UNPAID)
  currency                   String             @default("RSD") @db.VarChar(3)
  subtotal                   Decimal            @db.Decimal(12, 2)
  total                      Decimal            @db.Decimal(12, 2)
  requestedPickupDate        DateTime           @db.Date
  confirmedPickupAt          DateTime?          @db.Timestamptz(3)
  customerFirstName          String             @db.VarChar(80)
  customerLastName           String             @db.VarChar(80)
  customerEmail              String             @db.VarChar(254)
  customerPhone              String             @db.VarChar(32)
  customerNote               String?            @db.VarChar(500)
  cancellationReason         String?            @db.VarChar(500)
  confirmedAt                DateTime?          @db.Timestamptz(3)
  preparingAt                DateTime?          @db.Timestamptz(3)
  readyAt                    DateTime?          @db.Timestamptz(3)
  completedAt                DateTime?          @db.Timestamptz(3)
  cancelledAt                DateTime?          @db.Timestamptz(3)
  checkoutIdempotencyKeyHash String             @db.VarChar(64)
  checkoutRequestFingerprint String             @db.VarChar(64)
  createdAt                  DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt                  DateTime           @updatedAt @db.Timestamptz(3)
  customer                   CustomerUser       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  cart                       Cart               @relation(fields: [cartId], references: [id], onDelete: Restrict)
  pickupLocation             PickupLocation     @relation(fields: [pickupLocationId], references: [id], onDelete: Restrict)
  items                      OrderItem[]
  reservations               StockReservation[]
  events                     OrderEvent[]

  @@unique([customerId, checkoutIdempotencyKeyHash])
  @@index([customerId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([pickupLocationId, requestedPickupDate])
}

model OrderItem {
  id              String            @id @default(uuid()) @db.Uuid
  orderId         String            @db.Uuid
  productId       String            @db.Uuid
  variantId       String            @db.Uuid
  productName     String            @db.VarChar(160)
  productSlug     String            @db.VarChar(180)
  variantName     String            @db.VarChar(120)
  sku             String            @db.VarChar(80)
  packageAmount   Decimal           @db.Decimal(12, 3)
  measurementUnit MeasurementUnit
  quantity        Decimal           @db.Decimal(12, 3)
  unitPrice       Decimal           @db.Decimal(12, 2)
  lineTotal       Decimal           @db.Decimal(12, 2)
  imageUrl        String?           @db.VarChar(2048)
  createdAt       DateTime          @default(now()) @db.Timestamptz(3)
  order           Order             @relation(fields: [orderId], references: [id], onDelete: Restrict)
  product         Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant         ProductVariant    @relation(fields: [variantId], references: [id], onDelete: Restrict)
  reservation     StockReservation?

  @@index([orderId, createdAt])
  @@index([productId])
  @@index([variantId])
}

model StockReservation {
  id          String                 @id @default(uuid()) @db.Uuid
  orderId     String                 @db.Uuid
  orderItemId String                 @unique @db.Uuid
  variantId   String                 @db.Uuid
  quantity    Decimal                @db.Decimal(12, 3)
  status      StockReservationStatus @default(ACTIVE)
  reservedAt  DateTime               @default(now()) @db.Timestamptz(3)
  releasedAt  DateTime?              @db.Timestamptz(3)
  consumedAt  DateTime?              @db.Timestamptz(3)
  order       Order                  @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderItem   OrderItem              @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  variant     ProductVariant         @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([orderId, status])
  @@index([variantId, status])
}

model OrderEvent {
  id         String         @id @default(uuid()) @db.Uuid
  orderId    String         @db.Uuid
  type       String         @db.VarChar(100)
  fromStatus OrderStatus?
  toStatus   OrderStatus?
  actorType  OrderActorType
  adminId    String?        @db.Uuid
  customerId String?        @db.Uuid
  note       String?        @db.VarChar(500)
  metadata   Json?
  createdAt  DateTime       @default(now()) @db.Timestamptz(3)
  order      Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  admin      AdminUser?     @relation(fields: [adminId], references: [id], onDelete: Restrict)
  customer   CustomerUser?  @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
  @@index([adminId, createdAt])
  @@index([customerId, createdAt])
}
